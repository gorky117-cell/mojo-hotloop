    except e:
        abort(String("error creating Python Mojo module: ", e))

def _pywrap_accumulate_haversine_distance(arg0: PythonObject, arg1: PythonObject) raises -> PythonObject:
    var _builtins = Python.import_module("builtins")
    var _has_ctypes = True
    if _has_ctypes:
        if not (Bool(py=_builtins.hasattr(arg0, "ctypes")) and Bool(py=_builtins.hasattr(arg0, "ndim")) and Bool(py=_builtins.hasattr(arg0, "dtype")) and Bool(py=_builtins.hasattr(arg0, "flags"))):
            _has_ctypes = False
        elif Int(py=arg0.ndim) != 1 or String(py=arg0.dtype.name) != "float64" or not Bool(py=arg0.flags.c_contiguous):
            _has_ctypes = False
    if _has_ctypes:
        if not (Bool(py=_builtins.hasattr(arg1, "ctypes")) and Bool(py=_builtins.hasattr(arg1, "ndim")) and Bool(py=_builtins.hasattr(arg1, "dtype")) and Bool(py=_builtins.hasattr(arg1, "flags"))):
            _has_ctypes = False
        elif Int(py=arg1.ndim) != 1 or String(py=arg1.dtype.name) != "float64" or not Bool(py=arg1.flags.c_contiguous):
            _has_ctypes = False
    if _has_ctypes:
        var _n_lats = Int(py=arg0.__len__())
        var _lats_addr = Int(py=arg0.ctypes.data)
        var _lats_op = OpaquePointer[MutUntrackedOrigin](unsafe_from_address=_lats_addr)
        var _n_lons = Int(py=arg1.__len__())
        var _lons_addr = Int(py=arg1.ctypes.data)
        var _lons_op = OpaquePointer[MutUntrackedOrigin](unsafe_from_address=_lons_addr)
        var _res = _ptr_accumulate_haversine_distance(_lats_op, _n_lats, _lons_op, _n_lons)
        return PythonObject(_res)
    else:
        var _n_lats = Int(py=arg0.__len__())
        var lats = List[Float64](capacity=_n_lats)
        for _i in range(_n_lats):
            lats.append(Float64(py=arg0[_i]))
        var _n_lons = Int(py=arg1.__len__())
